# Copia este archivo como ".env" en el servidor y pon tus datos reales.
# NUNCA subas el archivo .env a internet ni lo compartas.
CLIPRADAR_ADMIN_EMAIL=tu-correo@ejemplo.com
CLIPRADAR_ADMIN_PASS=pon-aqui-una-contraseña-larga-y-unica

# Opcional: que cada clip terminado te llegue al móvil para solo publicarlo.
# Telegram: crea un bot con @BotFather y pon su token; el chat id es el de tu conversación con el bot.
# CLIPRADAR_TELEGRAM_TOKEN=
# CLIPRADAR_TELEGRAM_CHAT_ID=
# Discord: URL de un webhook de tu servidor.
# CLIPRADAR_DISCORD_WEBHOOK=
